{
  "version": 2,
  "builds": [
    {
      "src": "leetflix-frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    },
    {
      "src": "leetflix-backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(shows|quizzes|signup|login|admin-login|add-question|bulk-upload|submit-score|leaderboard|global-leaderboard)(.*)",
      "dest": "leetflix-backend/server.js"
    },
    {
      "src": "/static/(.*)",
      "dest": "leetflix-frontend/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "leetflix-frontend/$1"
    }
  ]
}
